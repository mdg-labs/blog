{
  "permissions": {
    "allow": [
      "Bash(git commit:*)",
      "Bash(git push origin dev)",
      "Bash(.claude/scripts/gh-rest.sh:*)",
      "Bash(.claude/scripts/issue-status.sh:*)",
      "Bash(.claude/scripts/epic-status.sh:*)",
      "Bash(.claude/scripts/issue-readiness.sh:*)",
      "Bash(.claude/scripts/security-history.sh:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm install:*)",
      "Bash(actionlint:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git add -A:*)",
      "Bash(git add --all:*)",
      "Bash(git add .)"
    ]
  }
}
